<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FerroSuite.IA</RootNamespace>
    <AssemblyName>FerroSuite</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Navegador integrado para mostrar las pantallas dentro de la ventana -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
    <!-- Conexión con SQL Server -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scripts de la base de datos: se copian junto al programa -->
    <None Update="BaseDatos\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- Pantallas (carpeta frontend, al lado de este proyecto): se copian junto al programa -->
    <Content Include="..\frontend\**\*" Link="frontend\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
